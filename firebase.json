{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "database.rules.json", "scripts/**", "android/**", "ios/**", ".git/**", ".github/**", ".firebase/**", ".firebaserc", "**/.gitignore", "**/.gitattributes", "**/.DS_Store", "**/node_modules/**", "README.md"],
    "headers": [
      { "source": "sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "icons/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
    ]
  }
}
