{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false }
    },

    "secretCodes": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".indexOn": ["used"],
      "$code": {
        ".read": true,
        ".write": "auth != null && (root.child('admins/' + auth.uid).val() === true || (data.exists() && data.child('used').val() === false && newData.child('used').val() === true && newData.child('usedBy').val() === auth.uid))",
        ".validate": "$code.length === 10 && newData.hasChild('used')"
      }
    },

    "usernames": {
      "$userId": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && (newData.child('uid').val() === auth.uid || (newData.child('ownerUid').val() === auth.uid && root.child('owners/' + auth.uid).exists()))) || (data.exists() && !newData.exists() && data.child('ownerUid').val() === auth.uid))"
      }
    },

    "owners": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name', 'userId', 'phone', 'code']) && root.child('secretCodes/' + newData.child('code').val() + '/usedBy').val() === auth.uid",
        "email": { ".validate": "newData.isString() && newData.val().length <= 120 && newData.val().matches(/^[^ @]+@[^ @]+[.][^ @]+$/)" }
      }
    },

    "buses": {
      ".read": true,
      "$reg": {
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid && root.child('owners/' + auth.uid).exists()) || data.child('ownerUid').val() === auth.uid)",
        ".validate": "!newData.exists() || newData.hasChildren(['regNo', 'busName', 'busKey', 'ownerUid'])",
        "ownerUid": { ".validate": "!data.exists() || newData.val() === data.val()" }
      }
    },

    "drivers": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || data.child('ownerUid').val() === auth.uid)",
        ".write": "auth != null && root.child('owners/' + auth.uid).exists() && (data.exists() ? data.child('ownerUid').val() === auth.uid : newData.child('ownerUid').val() === auth.uid)",
        ".validate": "!newData.exists() || root.child('buses/' + newData.child('regKey').val() + '/ownerUid').val() === auth.uid"
      }
    },

    "ownerDrivers": {
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        ".write": "auth != null && auth.uid === $ownerUid"
      }
    },

    "stops": {
      ".read": true,
      "$stopId": {
        ".write": "auth != null && !data.exists() && (root.child('drivers/' + auth.uid).exists() || root.child('owners/' + auth.uid).exists())",
        ".validate": "newData.hasChildren(['name', 'lat', 'lng']) && newData.child('name').isString() && newData.child('name').val().length <= 80 && newData.child('lat').isNumber() && newData.child('lng').isNumber()"
      }
    },

    "routes": {
      ".read": true,
      "$busKey": {
        ".write": "auth != null && root.child('drivers/' + auth.uid + '/busKey').val() === $busKey",
        ".validate": "newData.hasChildren(['busName', 'stops', 'source', 'destination'])"
      }
    },

    "live": {
      ".read": true,
      "$reg": {
        ".write": "auth != null && (root.child('buses/' + $reg + '/driverUid').val() === auth.uid || root.child('buses/' + $reg + '/ownerUid').val() === auth.uid)",
        ".validate": "!newData.exists() || (newData.hasChildren(['ts']) && (!newData.hasChild('lat') || (newData.child('lat').isNumber() && newData.child('lng').isNumber())) && (newData.child('online').val() === false || root.child('billingStatus/' + root.child('buses/' + $reg + '/ownerUid').val() + '/status').val() !== 'empty'))"
      }
    },

    "settings": {
      "billing": {
        ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
        ".write": "auth != null && root.child('admins/' + auth.uid).val() === true"
      },
      "payment": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('admins/' + auth.uid).val() === true"
      }
    },

    "billing": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$ownerUid": { ".read": "auth != null && auth.uid === $ownerUid" }
    },

    "billingStatus": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$ownerUid": {
        ".read": "auth != null && (auth.uid === $ownerUid || root.child('drivers/' + auth.uid + '/ownerUid').val() === $ownerUid)",
        "status": { ".validate": "newData.val().matches(/^(active|low|empty)$/)" }
      }
    },

    "usageCounts": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$regKey": {
        "$hour": {
          ".write": "auth != null && root.child('buses/' + $regKey + '/driverUid').val() === auth.uid",
          ".validate": "$hour.matches(/^[0-9]{10}$/) && newData.isNumber() && newData.val() > (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 5000"
        }
      }
    },

    "usage": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$ownerUid": { ".read": "auth != null && auth.uid === $ownerUid" }
    },

    "usageAdmin": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true"
    },

    "rechargeRequests": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$ownerUid": {
        ".read": "auth != null && auth.uid === $ownerUid",
        "$id": {
          ".write": "auth != null && ((auth.uid === $ownerUid && !data.exists() && root.child('owners/' + auth.uid).exists()) || root.child('admins/' + auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['amountInr', 'createdAt', 'status']) && newData.child('amountInr').isNumber() && newData.child('amountInr').val() >= 100 && newData.child('amountInr').val() <= 100000 && (root.child('admins/' + auth.uid).val() === true || (newData.child('status').val() === 'pending' && newData.child('createdAt').val() === now))",
          "status": { ".validate": "newData.val().matches(/^(pending|confirmed|rejected)$/)" }
        }
      }
    },

    "transactions": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true"
    },

    "ownerTransactions": {
      ".read": "auth != null && root.child('admins/' + auth.uid).val() === true",
      ".write": "auth != null && root.child('admins/' + auth.uid).val() === true",
      "$ownerUid": { ".read": "auth != null && auth.uid === $ownerUid" }
    },

    "crowd": {
      ".read": true,
      "$reg": {
        ".write": "auth != null && root.child('buses/' + $reg).exists()",
        ".validate": "newData.child('level').val().matches(/^(empty|moderate|crowded|packed)$/) && newData.child('ts').val() === now"
      }
    },

    "feedback": {
      ".read": true,
      "$reg": {
        "$fid": {
          ".write": "auth != null && !data.exists() && newData.child('by').val() === auth.uid",
          ".validate": "newData.child('level').val().matches(/^(empty|moderate|crowded|packed)$/) && newData.child('ts').val() === now"
        }
      }
    },

    "offlineLogs": {
      "$regKey": {
        ".read": "auth != null && root.child('buses/' + $regKey + '/ownerUid').val() === auth.uid",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('drivers/' + auth.uid + '/regKey').val() === $regKey) || (!newData.exists() && root.child('buses/' + $regKey + '/ownerUid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['busName', 'busKey', 'regNo', 'driverName', 'driverUid', 'ownerUid', 'start', 'end', 'durationSec']) && newData.child('driverUid').val() === auth.uid && newData.child('ownerUid').val() === root.child('buses/' + $regKey + '/ownerUid').val() && newData.child('end').val() >= newData.child('start').val() && newData.child('durationSec').val() >= 30",
          "busName": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "busKey": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "regNo": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "driverName": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "driverUid": { ".validate": "newData.isString()" },
          "ownerUid": { ".validate": "newData.isString()" },
          "start": { ".validate": "newData.isNumber()" },
          "end": { ".validate": "newData.isNumber()" },
          "durationSec": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "passengers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "lastFeedbackAt": {
          ".validate": "newData.val() === now && (!data.exists() || now - data.val() >= 110000)"
        },
        "coins": {
          ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 5 && newData.parent().child('lastFeedbackAt').val() === now"
        },
        "history": {
          "$hid": { ".validate": "!data.exists() && newData.child('coins').val() === 5" }
        },
        "favorites": { ".validate": "newData.hasChild('lists')" },
        "email": { ".validate": "newData.isString() && auth.token.email_verified === true && newData.val() === auth.token.email" },
        "createdAt": { ".validate": "!data.exists() && newData.val() === now" }
      }
    }
  }
}
